<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>PingRunner.App</RootNamespace>
    <AssemblyName>PingRunner</AssemblyName>
    <Title>Ping Runner</Title>
    <Description>Watch a connection's latency, jitter, packet loss and outages live, and measure its throughput.</Description>
    <ApplicationIcon>Assets\PingRunner.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="PingRunner.ReleaseBuild" Value="$(PingRunnerReleaseBuild)" />
    <InternalsVisibleTo Include="PingRunner.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PingRunner.Core\PingRunner.Core.csproj" />
    <ProjectReference Include="..\PingRunner.Infrastructure\PingRunner.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\PingRunner.ico" />
    <Resource Include="Assets\PingRunner.png" />
  </ItemGroup>

</Project>
