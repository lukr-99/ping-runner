<UserControl x:Class="PingRunner.App.Controls.StatTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Tile">
    <Border Style="{StaticResource PR.Card}" Padding="14,12">
        <StackPanel>
            <DockPanel>
                <Border DockPanel.Dock="Left"
                        Width="24"
                        Height="24"
                        Margin="0,0,8,0"
                        CornerRadius="7"
                        Background="{DynamicResource PR.AccentSoftBrush}">
                    <ui:SymbolIcon Symbol="{Binding Icon, ElementName=Tile}"
                                   FontSize="15"
                                   Foreground="{DynamicResource PR.AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding Label, ElementName=Tile}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource PR.TextSecondaryBrush}" />
            </DockPanel>
            <TextBlock Margin="0,6,0,0"
                       Text="{Binding Value, ElementName=Tile}"
                       Tag="{Binding Severity, ElementName=Tile}"
                       Style="{StaticResource PR.SeverityValue}"
                       FontSize="{Binding ValueSize, ElementName=Tile}"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Margin="0,4,0,0"
                       Text="{Binding Hint, ElementName=Tile}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource PR.TextSecondaryBrush}" />
        </StackPanel>
    </Border>
</UserControl>
