<UserControl x:Class="PingRunner.App.Controls.StatTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Tile">
    <Border Style="{StaticResource PR.Card}" Padding="14,12">
        <StackPanel>
            <TextBlock Text="{Binding Label, ElementName=Tile}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PR.TextSecondaryBrush}" />
            <TextBlock Margin="0,6,0,0"
                       Text="{Binding Value, ElementName=Tile}"
                       Tag="{Binding Severity, ElementName=Tile}"
                       Style="{StaticResource PR.SeverityValue}"
                       FontSize="{Binding ValueSize, ElementName=Tile}"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Margin="0,4,0,0"
                       Text="{Binding Hint, ElementName=Tile}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource PR.TextSecondaryBrush}" />
        </StackPanel>
    </Border>
</UserControl>
