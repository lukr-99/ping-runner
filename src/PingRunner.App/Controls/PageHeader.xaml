<UserControl x:Class="PingRunner.App.Controls.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Header">
    <DockPanel Margin="0,0,0,12">
        <ContentPresenter DockPanel.Dock="Right" VerticalAlignment="Center" Content="{Binding Actions, ElementName=Header}" />
        <Border DockPanel.Dock="Left"
                Width="46"
                Height="46"
                Margin="0,0,14,0"
                VerticalAlignment="Center"
                CornerRadius="12"
                Background="{DynamicResource PR.AccentSoftBrush}">
            <ui:SymbolIcon Symbol="{Binding Icon, ElementName=Header}"
                           FontSize="24"
                           Foreground="{DynamicResource PR.AccentBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
        </Border>
        <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource PR.PageTitle}" Text="{Binding Title, ElementName=Header}" />
            <TextBlock Style="{StaticResource PR.PageSubtitle}" Text="{Binding Subtitle, ElementName=Header}" />
        </StackPanel>
    </DockPanel>
</UserControl>
