<Page x:Class="PingRunner.App.Views.MonitorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PingRunner.App.Controls"
      xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
      Title="Monitor"
      Foreground="{DynamicResource PR.TextPrimaryBrush}">
    <Grid Margin="{StaticResource PR.PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="220" />
        </Grid.RowDefinitions>

        <!-- Title and live status. -->
        <controls:PageHeader Grid.Row="0" Icon="Pulse24" Title="Monitor" Subtitle="Latency, jitter, packet loss and outages, live.">
            <controls:PageHeader.Actions>
                <Border Style="{StaticResource PR.StatusPill}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource PR.StatusDot}" VerticalAlignment="Center" />
                        <TextBlock Margin="8,0,0,0" Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Margin="10,0,0,0" Text="{Binding ElapsedText}" FontFamily="Consolas" VerticalAlignment="Center"
                                   Foreground="{DynamicResource PR.TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <!-- The run form. -->
        <Border Grid.Row="1" Style="{StaticResource PR.Card}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="180" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource PR.FieldLabel}" Text="Host or IP address" />
                    <ComboBox IsEditable="True"
                              ItemsSource="{Binding RecentTargets}"
                              Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding IsIdle}"
                              ToolTip="Recent targets are in the list" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource PR.FieldLabel}" Text="Every (ms)" />
                    <TextBox Text="{Binding IntervalText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource PR.FieldLabel}" Text="Timeout (ms)" />
                    <TextBox Text="{Binding TimeoutText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource PR.FieldLabel}" Text="Run for" />
                    <ComboBox ItemsSource="{Binding DurationOptions}" SelectedItem="{Binding SelectedDuration}" />
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <ui:Button Content="Start"
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon Play24}"
                               MinWidth="96"
                               Height="34"
                               Command="{Binding StartCommand}"
                               Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Content="Stop"
                               Appearance="Danger"
                               Icon="{ui:SymbolIcon Stop24}"
                               MinWidth="96"
                               Height="34"
                               Command="{Binding StopCommand}"
                               Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Style="{StaticResource PR.TonalButton}" Margin="8,0,0,0"
                               Height="34"
                               Icon="{ui:SymbolIcon Copy24}"
                               ToolTip="Copy a text summary of this session"
                               Command="{Binding CopySummaryCommand}" />
                    <ui:Button Style="{StaticResource PR.TonalButton}" Margin="6,0,0,0"
                               Height="34"
                               Icon="{ui:SymbolIcon Delete24}"
                               ToolTip="Clear the session"
                               Command="{Binding ClearCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <ui:InfoBar Grid.Row="2"
                    Margin="0,10,0,0"
                    Title="Check the form"
                    Message="{Binding Error}"
                    Severity="Warning"
                    IsClosable="False"
                    IsOpen="{Binding HasError}" />

        <!-- The figures. -->
        <primitives:UniformGrid Grid.Row="3" Margin="-4,8,-4,4" Columns="4" Rows="2">
            <controls:StatTile Margin="4" Icon="Timer24" Label="Average latency" Value="{Binding Stats.Average}" Hint="{Binding Stats.AverageHint}" />
            <controls:StatTile Margin="4" Icon="DataHistogram24" Label="Median" Value="{Binding Stats.Median}" Hint="{Binding Stats.Percentiles}" />
            <controls:StatTile Margin="4" Icon="ArrowSwap24" Label="Jitter" Value="{Binding Stats.Jitter}" Hint="{Binding Stats.JitterHint}" />
            <controls:StatTile Margin="4" Icon="WifiWarning24" Label="Packet loss" Value="{Binding Stats.Loss}" Hint="{Binding Stats.LossHint}" Severity="{Binding Stats.LossSeverity}" />
            <controls:StatTile Margin="4" Icon="Call24" Label="Call quality" Value="{Binding Stats.Quality}" Hint="{Binding Stats.QualityHint}" Severity="{Binding Stats.QualitySeverity}" />
            <controls:StatTile Margin="4" Icon="PlugDisconnected24" Label="Outages" Value="{Binding Stats.Outages}" Hint="{Binding Stats.OutagesHint}" Severity="{Binding Stats.OutageSeverity}" />
            <controls:StatTile Margin="4" Icon="Send24" Label="Pings sent" Value="{Binding Stats.Sent}" Hint="{Binding Stats.SentHint}" />
            <controls:StatTile Margin="4" Icon="Flash24" Label="Worst spikes" Value="{Binding Stats.Spikes}" Hint="Mean of the 50 slowest replies" />
        </primitives:UniformGrid>

        <!-- The last two minutes, and the newest pings. -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PR.Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource PR.Hint}" VerticalAlignment="Center"
                                   Text="Full history on the Graph page" />
                        <TextBlock Style="{StaticResource PR.SectionLabel}" Margin="0" Text="LAST 120 PINGS" />
                    </DockPanel>
                    <controls:LatencyChart Attempts="{Binding ChartAttempts}" IsInteractive="True" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PR.Card}" Padding="0,14,0,6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PR.SectionLabel}" Margin="16,0,16,8" Text="RECENT PINGS" />
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PR.Hint}" Margin="16,0,16,0" Text="Nothing yet."
                               Visibility="{Binding RecentAttempts.Count, Converter={StaticResource ZeroToVisible}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RecentAttempts}" Margin="16,0,10,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="68" />
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Time}" FontFamily="Consolas" FontSize="12"
                                                   Foreground="{DynamicResource PR.TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Latency}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource PR.AccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLost}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource PR.DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding Details}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource PR.TextSecondaryBrush}" VerticalAlignment="Center"
                                                   ToolTip="{Binding Details}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
