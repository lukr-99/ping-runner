<Page x:Class="PingRunner.App.Views.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PingRunner.App.Controls"
      Title="About"
      Foreground="{DynamicResource PR.TextPrimaryBrush}">
    <Page.Resources>
        <!-- One line of a list: a small accent dot, then text. -->
        <DataTemplate x:Key="BulletLine">
            <DockPanel Margin="0,3">
                <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Margin="0,7,10,0" VerticalAlignment="Top"
                         Fill="{DynamicResource PR.AccentBrush}" />
                <TextBlock Style="{StaticResource PR.Body}" Text="{Binding}" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="LinkButton">
            <ui:Button Margin="0,0,8,8"
                       Style="{StaticResource PR.TonalButton}"
                       Content="{Binding Label}"
                       ToolTip="{Binding Hint}"
                       Icon="{ui:SymbolIcon Open24}"
                       Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                       CommandParameter="{Binding Url}" />
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="{StaticResource PR.PagePadding}" MaxWidth="760" HorizontalAlignment="Left">

            <!-- Hero: the icon, the name and version, and a ping trace in the accent color. -->
            <Border Style="{StaticResource PR.Card}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Polyline Points="0,86 60,86 90,86 110,40 128,112 150,70 172,86 240,86 270,86 292,56 312,100 334,86 520,86 560,86 584,30 606,120 630,66 652,86 760,86"
                              Stroke="{DynamicResource PR.AccentBrush}" StrokeThickness="2" Opacity="0.35"
                              StrokeLineJoin="Round" Stretch="Fill" Width="300" Height="64" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,16,0" />
                    <DockPanel Margin="24,22,24,22">
                        <Border DockPanel.Dock="Left" Width="84" Height="84" Margin="0,0,20,0" CornerRadius="20"
                                Background="{DynamicResource PR.AccentSoftBrush}" VerticalAlignment="Top">
                            <Image Source="/PingRunner;component/Assets/PingRunner.png" Width="56" Height="56"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="32" FontWeight="SemiBold" Text="{Binding Content.Name}"
                                       Foreground="{DynamicResource PR.TextPrimaryBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,8">
                                <Border Padding="10,3" CornerRadius="12" BorderThickness="1" Background="{DynamicResource PR.AccentSoftBrush}"
                                        BorderBrush="{DynamicResource PR.AccentBrush}">
                                    <TextBlock Style="{StaticResource PR.AccentValue}" FontSize="13" Text="{Binding Version}" />
                                </Border>
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource PR.Hint}" Text="{Binding BuildLabel}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource PR.Body}" FontSize="16" Text="{Binding Content.Tagline}" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <Border Margin="0,12,0,0" Style="{StaticResource PR.Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PR.SectionLabel}" Text="WHAT IT IS" />
                    <TextBlock Style="{StaticResource PR.Body}" Text="{Binding Content.Description}" />
                </StackPanel>
            </Border>

            <Border Margin="0,12,0,0" Style="{StaticResource PR.Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PR.SectionLabel}" Text="MADE BY" />
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,14,0" CornerRadius="22"
                                Background="{DynamicResource PR.AccentSoftBrush}" VerticalAlignment="Top">
                            <ui:SymbolIcon Symbol="Person24" FontSize="22" Foreground="{DynamicResource PR.AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Content.AuthorName}"
                                       Foreground="{DynamicResource PR.TextPrimaryBrush}" />
                            <TextBlock Margin="0,2,0,8" Style="{StaticResource PR.Hint}" Text="{Binding Content.AuthorNote}" />
                            <ItemsControl ItemsSource="{Binding Content.AuthorLinks}" ItemTemplate="{StaticResource LinkButton}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,12,0,0" Style="{StaticResource PR.Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PR.SectionLabel}" Text="FEEDBACK AND BUGS" />
                    <TextBlock Margin="0,0,0,10" Style="{StaticResource PR.Body}" Text="{Binding Content.FeedbackNote}" />
                    <ItemsControl ItemsSource="{Binding Content.FeedbackLinks}" ItemTemplate="{StaticResource LinkButton}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource PR.Hint}" Text="Links open in your browser." />
                </StackPanel>
            </Border>

            <Border Margin="0,12,0,0" Style="{StaticResource PR.Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PR.SectionLabel}" Text="YOUR DATA" />
                    <ItemsControl ItemsSource="{Binding Content.DataLines}" ItemTemplate="{StaticResource BulletLine}" />
                    <TextBlock Margin="0,10,0,4" Style="{StaticResource PR.FieldLabel}" Text="WHAT GOES ONLINE" />
                    <ItemsControl ItemsSource="{Binding Content.OnlineLines}" ItemTemplate="{StaticResource BulletLine}" />
                    <DockPanel Margin="0,10,0,0">
                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource PR.TonalButton}" Content="Open folder"
                                   Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenDataFolderCommand}" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource PR.Hint}" FontFamily="Consolas"
                                   Text="{Binding DataFolder}" TextWrapping="Wrap" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,12,0,0" Style="{StaticResource PR.Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PR.SectionLabel}" Text="CREDITS AND LICENCE" />
                    <TextBlock Style="{StaticResource PR.Body}">
                        <Run Text="Ping Runner is licensed under" />
                        <Run Text="{Binding Content.LicenceName, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="." />
                        <Run Text="{Binding Content.LicenceNote, Mode=OneWay}" />
                    </TextBlock>
                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Content.Credits}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4">
                                    <Border DockPanel.Dock="Right" Padding="8,2" CornerRadius="10" VerticalAlignment="Center"
                                            Background="{DynamicResource PR.AccentSoftBrush}">
                                        <TextBlock Style="{StaticResource PR.AccentValue}" FontSize="12" Text="{Binding Licence}" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource PR.Body}" FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock Style="{StaticResource PR.Hint}" Text="{Binding Role}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,10,0,0">
                        <ui:Button Margin="0,0,8,0" Style="{StaticResource PR.TonalButton}" Content="Read the licence" Icon="{ui:SymbolIcon Open24}"
                                   Command="{Binding OpenLinkCommand}" CommandParameter="{Binding Content.LicenceLink.Url}" />
                        <ui:Button Style="{StaticResource PR.TonalButton}" Content="Source code" Icon="{ui:SymbolIcon Code24}"
                                   Command="{Binding OpenLinkCommand}" CommandParameter="https://github.com/lukr-99/ping-runner" />
                    </WrapPanel>
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource PR.Hint}"
                               Text="The full list, with copyright lines, is THIRD-PARTY-NOTICES.md, installed beside the app." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
