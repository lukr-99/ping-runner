<Page x:Class="PingRunner.App.Views.GraphPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PingRunner.App.Controls"
      xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
      Title="Graph"
      Foreground="{DynamicResource PR.TextPrimaryBrush}">
    <Grid Margin="{StaticResource PR.PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="260" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Icon="DataLine24" Title="Graph" Subtitle="{Binding SourceText}">
            <controls:PageHeader.Actions>
                <ui:Button Content="Back to live data"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon Pulse24}"
                           Command="{Binding UseLiveDataCommand}"
                           Visibility="{Binding IsImported, Converter={StaticResource BoolToVisibility}}" />
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <!-- Range, zoom and files. -->
        <Border Grid.Row="1" Style="{StaticResource PR.Card}" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Style="{StaticResource PR.TonalButton}" Content="Import" Icon="{ui:SymbolIcon ArrowImport24}" Command="{Binding ImportCommand}"
                               ToolTip="Ping data from a CSV file or an Excel workbook" />
                    <ui:DropDownButton Margin="6,0,0,0" Content="Export" Icon="{ui:SymbolIcon ArrowExportLtr24}">
                        <ui:DropDownButton.Flyout>
                            <ContextMenu x:Name="ExportMenu">
                                <MenuItem Header="Pings on screen, as CSV" Command="{Binding ExportVisibleCommand}" />
                                <MenuItem Header="Every ping in the source, as CSV" Command="{Binding ExportAllCommand}" />
                                <MenuItem Header="Chart and figures, as a PNG image" Click="ExportPng_OnClick" />
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>
                    <ui:Button Margin="6,0,0,0" Appearance="Primary" Content="Report" Icon="{ui:SymbolIcon DocumentPdf24}" Command="{Binding RequestReportCommand}"
                               ToolTip="A PDF or Excel report of what the Graph shows" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PR.FieldLabel}" Margin="0,0,8,0" VerticalAlignment="Center" Text="Range" />
                    <ComboBox Width="170" ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange}" />
                    <ui:Button Style="{StaticResource PR.TonalButton}" Margin="8,0,0,0" Icon="{ui:SymbolIcon ArrowReset24}" Content="Reset zoom" Command="{Binding ResetZoomCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ui:InfoBar Grid.Row="2"
                    Margin="0,8,0,0"
                    Title="Import"
                    Message="{Binding Notice}"
                    Severity="Informational"
                    IsClosable="True"
                    IsOpen="{Binding HasNotice, Mode=TwoWay}" />

        <!-- Everything below is what "PNG" exports. -->
        <Grid x:Name="ExportSurface" Grid.Row="3" Grid.RowSpan="2" Background="{DynamicResource PR.BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <primitives:UniformGrid Grid.Row="0" Margin="-4,8,-4,4" Columns="6" Rows="1">
                <controls:StatTile Margin="4" ValueSize="18" Icon="Timer24" Label="Average" Value="{Binding Stats.Average}" Hint="{Binding Stats.AverageHint}" />
                <controls:StatTile Margin="4" ValueSize="18" Icon="DataHistogram24" Label="Median" Value="{Binding Stats.Median}" Hint="{Binding Stats.Percentiles}" />
                <controls:StatTile Margin="4" ValueSize="18" Icon="ArrowSwap24" Label="Jitter" Value="{Binding Stats.Jitter}" Hint="{Binding Stats.JitterHint}" />
                <controls:StatTile Margin="4" ValueSize="18" Icon="WifiWarning24" Label="Packet loss" Value="{Binding Stats.Loss}" Hint="{Binding Stats.LossHint}" Severity="{Binding Stats.LossSeverity}" />
                <controls:StatTile Margin="4" ValueSize="18" Icon="PlugDisconnected24" Label="Outages" Value="{Binding Stats.Outages}" Hint="{Binding Stats.OutagesHint}" Severity="{Binding Stats.OutageSeverity}" />
                <controls:StatTile Margin="4" ValueSize="18" Icon="Call24" Label="Call quality" Value="{Binding Stats.Quality}" Hint="{Binding Stats.QualityHint}" Severity="{Binding Stats.QualitySeverity}" />
            </primitives:UniformGrid>

            <Border Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource PR.Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Rectangle Width="14" Height="3" Fill="{DynamicResource PR.AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource PR.Hint}" Margin="6,0,14,0" Text="Reply" />
                            <Rectangle Width="10" Height="10" Fill="{DynamicResource PR.DangerSoftBrush}" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource PR.Hint}" Margin="6,0,14,0" Text="Lost" />
                            <Rectangle Width="14" Height="1" Stroke="{DynamicResource PR.TextPrimaryBrush}" StrokeDashArray="3 3" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource PR.Hint}" Margin="6,0,0,0" Text="Average" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource PR.Hint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding ViewText, Mode=OneWay}" />
                            <Run Text="   ·   Scroll to zoom, drag to pan, double-click to reset" />
                        </TextBlock>
                    </DockPanel>
                    <controls:LatencyChart x:Name="Chart"
                                           Attempts="{Binding RangedAttempts}"
                                           Zoom="{Binding Zoom, Mode=TwoWay}"
                                           IsInteractive="True"
                                           EmptyText="No pings to show. Start a run on the Monitor page, or import a file." />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
