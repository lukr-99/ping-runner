<Page x:Class="PingRunner.App.Views.SpeedTestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PingRunner.App.Controls"
      xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
      Title="Speed test"
      Foreground="{DynamicResource PR.TextPrimaryBrush}">
    <Grid Margin="{StaticResource PR.PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Icon="TopSpeed24" Title="Speed test"
                             Subtitle="{Binding ServerName, StringFormat=Download and upload throughput\, and latency under load\, against {0}.}" />

        <!-- The running test. -->
        <Border Grid.Row="1" Style="{StaticResource PR.Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="4,4,20,4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentRate}" FontSize="56" FontWeight="SemiBold" Foreground="{DynamicResource PR.AccentBrush}" />
                    <TextBlock Margin="2,-4,0,0" Text="{Binding CurrentDirection}" FontSize="14" Foreground="{DynamicResource PR.TextSecondaryBrush}" />
                    <TextBlock Margin="2,14,0,6" Text="{Binding PhaseText}" Style="{StaticResource PR.Body}" FontSize="13" />
                    <ProgressBar Height="4" Maximum="1" Value="{Binding Progress}" Margin="2,0,0,14" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="Start test"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon Play24}"
                                   MinWidth="120"
                                   Command="{Binding RunCommand}" />
                        <ui:Button Style="{StaticResource PR.TonalButton}" Margin="8,0,0,0"
                                   Content="Cancel"
                                   Icon="{ui:SymbolIcon Stop24}"
                                   Command="{Binding CancelCommand}"
                                   Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>

                <DockPanel Grid.Column="1">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                        <Rectangle Width="14" Height="3" Fill="{DynamicResource PR.AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource PR.Hint}" Margin="6,0,14,0" Text="Download" />
                        <Rectangle Width="14" Height="2" Stroke="{DynamicResource PR.TextSecondaryBrush}" StrokeThickness="2" StrokeDashArray="1.5 1" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource PR.Hint}" Margin="6,0,0,0" Text="Upload" />
                    </StackPanel>
                    <controls:ThroughputChart Height="210"
                                              Download="{Binding DownloadPoints}"
                                              Upload="{Binding UploadPoints}"
                                              Duration="{Binding TestDuration}" />
                </DockPanel>
            </Grid>
        </Border>

        <ui:InfoBar Grid.Row="2"
                    Margin="0,10,0,0"
                    Title="Speed test failed"
                    Message="{Binding Error}"
                    Severity="Error"
                    IsClosable="False"
                    IsOpen="{Binding HasError}" />

        <!-- The last result. -->
        <primitives:UniformGrid Grid.Row="3" Margin="-4,8,-4,4" Columns="5" Rows="1"
                                DataContext="{Binding Latest}"
                                Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
            <controls:StatTile Margin="4" Icon="ArrowDownload24" Label="Download" Value="{Binding DownloadShort}" Hint="{Binding DownloadPeak}" />
            <controls:StatTile Margin="4" Icon="ArrowUpload24" Label="Upload" Value="{Binding UploadShort}" Hint="{Binding UploadPeak}" />
            <controls:StatTile Margin="4" Icon="Timer24" Label="Idle latency" Value="{Binding IdleLatency}" Hint="{Binding IdleLatencyHint}" />
            <controls:StatTile Margin="4" Icon="Gauge24" Label="Latency under load" Value="{Binding LoadedLatency}" Hint="Median while downloading / uploading" />
            <controls:StatTile Margin="4" Icon="Flash24" Label="Bufferbloat" Value="{Binding Grade}" Hint="{Binding GradeHint}" Severity="{Binding GradeSeverity}" />
        </primitives:UniformGrid>

        <!-- This session's results. -->
        <Border Grid.Row="4" Margin="0,8,0,0" Style="{StaticResource PR.Card}" Padding="0,14,0,8">
            <DockPanel Grid.IsSharedSizeScope="True">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource PR.SectionLabel}" Margin="16,0,16,6" Text="THIS SESSION" />
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource PR.Hint}" Margin="16,8,16,0" Text="{Binding DataHint}" />
                <Grid DockPanel.Dock="Top" Margin="16,0,16,4" TextElement.FontSize="12" TextElement.Foreground="{DynamicResource PR.TextSecondaryBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="When" Width="80" />
                        <ColumnDefinition SharedSizeGroup="Down" Width="120" />
                        <ColumnDefinition SharedSizeGroup="Up" Width="120" />
                        <ColumnDefinition SharedSizeGroup="Idle" Width="90" />
                        <ColumnDefinition SharedSizeGroup="Loaded" Width="150" />
                        <ColumnDefinition SharedSizeGroup="Grade" Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Time" />
                    <TextBlock Grid.Column="1" Text="Download" />
                    <TextBlock Grid.Column="2" Text="Upload" />
                    <TextBlock Grid.Column="3" Text="Idle" />
                    <TextBlock Grid.Column="4" Text="Under load (down / up)" />
                    <TextBlock Grid.Column="5" Text="Bufferbloat" />
                    <TextBlock Grid.Column="6" Text="Data used" />
                </Grid>
                <TextBlock DockPanel.Dock="Top" Margin="16,4,16,0" Style="{StaticResource PR.Hint}" Text="No tests yet."
                           Visibility="{Binding History.Count, Converter={StaticResource ZeroToVisible}}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding History}" Margin="16,0,16,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4" TextElement.FontSize="13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition SharedSizeGroup="When" />
                                        <ColumnDefinition SharedSizeGroup="Down" />
                                        <ColumnDefinition SharedSizeGroup="Up" />
                                        <ColumnDefinition SharedSizeGroup="Idle" />
                                        <ColumnDefinition SharedSizeGroup="Loaded" />
                                        <ColumnDefinition SharedSizeGroup="Grade" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding When}" FontFamily="Consolas" Foreground="{DynamicResource PR.TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding DownloadShort}" Style="{StaticResource PR.AccentValue}" />
                                    <TextBlock Grid.Column="2" Text="{Binding UploadShort}" Style="{StaticResource PR.AccentValue}" />
                                    <TextBlock Grid.Column="3" Text="{Binding IdleLatency}" />
                                    <TextBlock Grid.Column="4" Text="{Binding LoadedLatency}" />
                                    <TextBlock Grid.Column="5" Text="{Binding Grade}" Tag="{Binding GradeSeverity}" Style="{StaticResource PR.SeverityValue}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="6" Text="{Binding DataUsed}" Foreground="{DynamicResource PR.TextSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Page>
