<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PingRunner.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PingRunner.Infrastructure.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PingRunner.Core\PingRunner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Immutable history migrations (CodePrint data lifecycle); SqliteMigrator reads them by this prefix. -->
    <EmbeddedResource Include="History\Migrations\*.sql" LogicalName="PingRunner.History.Migrations.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
