<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>PingRunner</AssemblyName>
    <Title>Ping Runner</Title>
    <Product>Ping Runner</Product>
    <Description>Desktop ping runner with live graphing, CSV import/export, and long-session analysis.</Description>
    <Company>Krejci</Company>
    <Authors>Krejci</Authors>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <ApplicationIcon>Assets\PingerTool.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PingerTool.Core\PingerTool.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\PingerTool.ico" />
    <Resource Include="Assets\PingerTool.png" />
  </ItemGroup>

</Project>
