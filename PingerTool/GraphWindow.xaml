<Window x:Class="PingerTool.GraphWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:PingerTool.Controls"
        mc:Ignorable="d"
        Title="Ping Runner Graph"
        Icon="Assets/PingerTool.ico"
        Height="760"
        Width="1180"
        MinHeight="620"
        MinWidth="980">
    <Grid x:Name="ExportSurface"
          Margin="16"
          Background="#FFF4F7FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="16"
                CornerRadius="10"
                Background="#FF101B2D">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Foreground="White"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Text="Ping Graph Explorer" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="#FFD7E2F2"
                               FontSize="14"
                               Text="{Binding TargetHost, StringFormat=Tracking latency history for {0}.}" />
                </StackPanel>

                <Border Grid.Column="1"
                        Padding="12,8"
                        Background="#22324B"
                        CornerRadius="8"
                        VerticalAlignment="Center">
                    <TextBlock Foreground="#FFF4F7FB"
                               FontSize="14"
                               FontWeight="Medium"
                               Text="{Binding StatusText}" />
                </Border>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1"
                     Margin="0,16,0,12"
                     Columns="3">
            <Border Margin="0,0,12,12"
                    Padding="14"
                    CornerRadius="10"
                    Background="#FFEFF6FF"
                    BorderBrush="#FFB6D4FE"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Foreground="#FF24549A"
                               FontWeight="SemiBold"
                               Text="Samples" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Text="{Binding SentCount}" />
                </StackPanel>
            </Border>

            <Border Margin="0,0,12,12"
                    Padding="14"
                    CornerRadius="10"
                    Background="#FFF1FAF5"
                    BorderBrush="#FFA6F4C5"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Foreground="#FF067647"
                               FontWeight="SemiBold"
                               Text="Success / Failure" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Text="{Binding SuccessFailureSummary}" />
                </StackPanel>
            </Border>

            <Border Margin="0,0,12,12"
                    Padding="14"
                    CornerRadius="10"
                    Background="#FFFFFAEB"
                    BorderBrush="#FFFEC84B"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Foreground="#FFB54708"
                               FontWeight="SemiBold"
                               Text="Average Latency" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Text="{Binding AverageLatencyText}" />
                </StackPanel>
            </Border>

            <Border Margin="0,0,12,12"
                    Padding="14"
                    CornerRadius="10"
                    Background="#FFFDF2FA"
                    BorderBrush="#FFEEA9D7"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Foreground="#FFC11574"
                               FontWeight="SemiBold"
                               Text="Success Rate" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Text="{Binding SuccessRateText}" />
                </StackPanel>
            </Border>

            <Border Margin="0,0,12,0"
                    Padding="14"
                    CornerRadius="10"
                    Background="#FFF2F4F7"
                    BorderBrush="#FFD0D5DD"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Foreground="#FF344054"
                               FontWeight="SemiBold"
                               Text="Peak Latency" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Text="{Binding PeakLatencyText}" />
                </StackPanel>
            </Border>

            <Border Margin="0,0,12,0"
                    Padding="14"
                    CornerRadius="10"
                    Background="#FFEEF4FF"
                    BorderBrush="#FFB2CCFF"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Foreground="#FF1849A9"
                               FontWeight="SemiBold"
                               Text="Top 50 Spike Avg" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Text="{Binding Top50SpikeAverageText}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2"
                Padding="14"
                Background="#FFF7F9FC"
                BorderBrush="#FFD0D7E2"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <WrapPanel Margin="0,0,12,8">
                    <StackPanel Width="190"
                                Margin="0,0,12,8">
                        <TextBlock Foreground="#FF344054"
                                   FontWeight="SemiBold"
                                   Text="Range mode" />
                        <ComboBox Margin="0,6,0,0"
                                  ItemsSource="{Binding RangeModes}"
                                  SelectedItem="{Binding SelectedRangeMode}"
                                  DisplayMemberPath="Label" />
                    </StackPanel>

                    <StackPanel Width="190"
                                Margin="0,0,12,8">
                        <TextBlock Foreground="#FF344054"
                                   FontWeight="SemiBold"
                                   Text="Attempt window" />
                        <ComboBox Margin="0,6,0,0"
                                  ItemsSource="{Binding AttemptRangeOptions}"
                                  SelectedItem="{Binding SelectedAttemptRange}"
                                  DisplayMemberPath="Label"
                                  IsEnabled="{Binding IsAttemptRangeEnabled}" />
                    </StackPanel>

                    <StackPanel Width="190"
                                Margin="0,0,12,8">
                        <TextBlock Foreground="#FF344054"
                                   FontWeight="SemiBold"
                                   Text="Time window" />
                        <ComboBox Margin="0,6,0,0"
                                  ItemsSource="{Binding TimeWindowOptions}"
                                  SelectedItem="{Binding SelectedTimeWindow}"
                                  DisplayMemberPath="Label"
                                  IsEnabled="{Binding IsTimeWindowEnabled}" />
                    </StackPanel>
                </WrapPanel>

                <WrapPanel Grid.Column="1"
                           HorizontalAlignment="Right">
                    <Button Margin="0,0,8,8"
                            Padding="14,8"
                            Click="ImportDataButton_OnClick"
                            Content="Import CSV" />
                    <Button Margin="0,0,8,8"
                            Padding="14,8"
                            Click="ExportVisibleDataButton_OnClick"
                            Content="Export View CSV" />
                    <Button Margin="0,0,8,8"
                            Padding="14,8"
                            Click="ExportSourceDataButton_OnClick"
                            Content="Export Source CSV" />
                    <Button Margin="0,0,8,8"
                            Padding="14,8"
                            Click="ExportPngButton_OnClick"
                            Content="Export PNG" />
                    <Button Margin="0,0,0,8"
                            Padding="14,8"
                            Click="UseLiveDataButton_OnClick"
                            Content="Use Live Data"
                            IsEnabled="{Binding CanUseLiveData}" />
                </WrapPanel>

                <Grid Grid.Row="1"
                      Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Foreground="#FF344054"
                                   FontWeight="SemiBold"
                                   Text="{Binding SourceSummaryText}" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="#FF516074"
                                   Text="{Binding ViewSummaryText}" />
                    </StackPanel>

                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Foreground="#FF344054"
                                       FontWeight="SemiBold"
                                       Text="{Binding ZoomFactor, StringFormat=Zoom {0:0.0}x}" />
                            <Slider Margin="0,6,0,0"
                                    Minimum="1"
                                    Maximum="12"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="False"
                                    Value="{Binding ZoomFactor}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Foreground="#FF344054"
                                       FontWeight="SemiBold"
                                       Text="{Binding PanRatio, StringFormat=Pan {0:P0}}" />
                            <Slider Margin="0,6,0,0"
                                    Minimum="0"
                                    Maximum="1"
                                    TickFrequency="0.05"
                                    IsEnabled="{Binding CanPan}"
                                    Value="{Binding PanRatio}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Margin="0,12,0,0"
                Background="#FFF8FAFC"
                BorderBrush="#FFD0D7E2"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12">
            <controls:PingLatencyChart x:Name="LatencyChart"
                                       ItemsSource="{Binding ChartItemsSource}"
                                       RangeMode="{Binding SelectedRangeMode.Value}"
                                       RecentAttemptLimit="{Binding SelectedAttemptRange.Value}"
                                       RollingTimeWindow="{Binding SelectedTimeWindow.Value}"
                                       ZoomFactor="{Binding ZoomFactor}"
                                       PanRatio="{Binding PanRatio}" />
        </Border>

        <Border Grid.Row="4"
                Margin="0,12,0,0"
                Padding="12"
                Background="#FFF7F9FC"
                BorderBrush="#FFD0D7E2"
                BorderThickness="1"
                CornerRadius="10">
            <WrapPanel>
                <TextBlock Foreground="#FF24549A"
                           FontWeight="SemiBold"
                           Text="Blue line" />
                <TextBlock Margin="6,0,18,0"
                           Foreground="#FF516074"
                           Text="successful round-trip latency" />
                <TextBlock Foreground="#FFB42318"
                           FontWeight="SemiBold"
                           Text="Red markers" />
                <TextBlock Margin="6,0,18,0"
                           Foreground="#FF516074"
                           Text="failed or timed-out attempts" />
                <TextBlock Foreground="#FF516074"
                           Text="The chart is downsampled for rendering, but CSV exports keep the full filtered data set." />
            </WrapPanel>
        </Border>
    </Grid>
</Window>
