<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>PingRunner.Infrastructure.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PingRunner.Infrastructure\PingRunner.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- xUnit v3 on Microsoft.Testing.Platform (global.json). -->
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Samples\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="History\Fixtures\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
